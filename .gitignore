node_modules/
*.log
.DS_Store
dist/

# demo runtime state - private keys and mirrored chat data, local-only
demo/.identities/
demo/.data/
demo/.app-shell-identities/
demo/.app-shell-data/

# packages/app-shell/bin/bootstrap-platform.mjs's own local identities (private keys - never commit)
packages/app-shell/.platform-identities/

# generated by bootstrap-platform.mjs / any local deployment config - public keys only, but still
# not something to commit (per-deployment, and .env is a well-known place secrets end up over time)
.env

# generated at demo/app-shell-relay.mjs startup (real app-admin pubkey baked in) - see demo/app-shell-web/build.mjs
demo/app-shell-web/index.html

# generated at packages/app-shell/relay-server.js startup (bundle.js + a per-deployment index.html)
packages/app-shell/dist-web/

# relay deployment data (see docs/v5-space-core-guide.md §5)
relay-data/
