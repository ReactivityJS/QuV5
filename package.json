{
  "name": "quv5",
  "version": "0.1.0",
  "private": true,
  "description": "Qu V5 - a from-scratch, Yjs-native core for Qu: signed and end-to-end encrypted CRDT sync (Space/Node/Field), a blind relay, and persistence adapters. See docs/v5-space-core-guide.md.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node demo/auto-demo.mjs",
    "relay": "node packages/app-shell/relay-server.js",
    "bootstrap:platform": "node packages/app-shell/bin/bootstrap-platform.mjs",
    "demo:app-shell": "node demo/app-shell-demo.mjs",
    "demo:app-shell-relay": "node demo/app-shell-relay.mjs",
    "demo:app-shell-install": "node demo/install-app-shell-demo.mjs",
    "demo:legacy-chat-relay": "node demo/relay.mjs",
    "demo:legacy-chat-alice": "node demo/chat.mjs alice",
    "demo:legacy-chat-bob": "node demo/chat.mjs bob",
    "build:web": "node demo/web/build.mjs",
    "build:app-shell-web": "node demo/app-shell-web/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "license": "MIT"
}
